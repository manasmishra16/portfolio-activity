# ==============================================================================
# MANAS MISHRA PORTFOLIO — FASTAPI BACKEND CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL - Source of Truth)
# ------------------------------------------------------------------------------
# In production on Render, provide the connection string to your hosted PostgreSQL database
# (e.g. Supabase, Neon, or Render PostgreSQL).
# Format: postgresql+psycopg://username:password@hostname:5432/database
# Note: postgres:// and postgresql:// prefixes are also automatically supported.
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.example.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL NOTIFICATION (Resend API)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com (Free tier includes 3,000 emails/month).
# If this key is left blank, messages are still safely persisted to PostgreSQL,
# and the user receives a graceful confirmation.
RESEND_API_KEY=re_your_resend_api_key_here

# The email inbox where you want to receive new contact inquiries:
CONTACT_RECEIVER_EMAIL=manasmishra16@gmail.com

# Verified sender address or default testing address:
# For initial testing without a custom domain, you can use: Portfolio Inquiries <onboarding@resend.dev>
# For production with your verified domain: Portfolio Inquiries <contact@manasmishra.dev>
CONTACT_FROM_EMAIL=Portfolio Inquiries <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE MESSAGE RETRIEVAL
# ------------------------------------------------------------------------------
# Secret key used to access the secure GET /api/contact/messages endpoint
# via header 'X-Admin-Key: <ADMIN_SECRET_KEY>'
ADMIN_SECRET_KEY=generate_a_secure_random_key_here

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND ORIGIN PERMISSIONS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domains (in addition to localhost):
FRONTEND_ORIGINS=https://manasmishra.dev,https://www.manasmishra.dev
