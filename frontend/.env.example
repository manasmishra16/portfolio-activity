# ==============================================================================
# MANAS MISHRA PORTFOLIO — FRONTEND (NEXT.JS) CONFIGURATION
# ==============================================================================
# These variables are used strictly server-side by Next.js route handlers.
# NEVER prefix these with NEXT_PUBLIC_* to avoid exposing them to the client bundle.

# 1. URL of your deployed FastAPI backend service on Render
FASTAPI_URL=https://portfolio-backend-wlnv.onrender.com

# 2. Secret key used for authenticating with FastAPI's administrative endpoints
# Must match the ADMIN_SECRET_KEY configured on your FastAPI backend service.
ADMIN_SECRET_KEY=your_secure_admin_passphrase_here

# 3. Stable 32+ character key used to cryptographically sign HttpOnly admin session cookies
# Must be stable across deployments to prevent sessions from dropping on restart.
ADMIN_SESSION_SECRET=generate_a_random_32_character_token_here
